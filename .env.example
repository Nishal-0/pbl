# Root reference file for deployment values.
# Copy the frontend variables into frontend/.env for local frontend work.
# Copy the backend variables into backend/.env for local backend work.

VITE_API_URL=https://your-render-service.onrender.com
VITE_GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id

MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/customer-support-portal
JWT_SECRET=replace_with_a_minimum_32_character_random_secret
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
PORT=5000
CORS_ORIGINS=http://localhost:5173,https://your-frontend-project.vercel.app
FRONTEND_URL=https://your-frontend-project.vercel.app
SMTP_SERVICE=gmail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=Support Portal <support@example.com>
